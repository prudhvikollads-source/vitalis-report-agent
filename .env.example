# Vitalis config. Everything runs offline by default — no keys needed.
# Only set these if you want the Counselor's prose from a live LLM
# (flag math stays rule-based regardless).
VITALIS_MOCK=true
VITALIS_API_KEY=
VITALIS_MODEL=gpt-4o-mini
VITALIS_API_BASE=https://api.openai.com/v1
VITALIS_MIN_CONFIDENCE=0.5
